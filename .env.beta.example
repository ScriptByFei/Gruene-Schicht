# Public frontend configuration for a controlled beta. Do not put secrets here.
VITE_APP_ENV=beta
VITE_NEON_AUTH_URL=https://your-endpoint.neonauth.your-cell.eu-central-1.aws.neon.tech/neondb/auth
VITE_NEON_DATA_API_URL=https://your-endpoint.apirest.your-cell.eu-central-1.aws.neon.tech/neondb/rest/v1

# Keep false for the invite-only beta. Managed Better Auth signup must also be restricted.
VITE_REGISTRATION_ENABLED=false

# Enable only after testing Magic Link delivery with a dedicated SMTP provider.
# The Neon main plugin has disable_sign_up=true; verify it before deployment.
VITE_EMAIL_LINK_ENABLED=false

# Required before any public deployment.
VITE_LEGAL_OPERATOR_NAME=Your legal operator name
VITE_LEGAL_CONTACT_EMAIL=privacy@example.com
