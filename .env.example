# Public branch endpoints. They do not contain database credentials.
VITE_NEON_AUTH_URL=https://your-endpoint.neonauth.your-cell.eu-central-1.aws.neon.tech/neondb/auth
VITE_NEON_DATA_API_URL=https://your-endpoint.apirest.your-cell.eu-central-1.aws.neon.tech/neondb/rest/v1

# Local development only. Production/beta starts closed.
VITE_APP_ENV=local
VITE_REGISTRATION_ENABLED=true
VITE_LEGAL_OPERATOR_NAME=
VITE_LEGAL_CONTACT_EMAIL=

# DATABASE_URL and DATABASE_URL_UNPOOLED are pulled by `neon env pull`.
# Never expose either connection string through a VITE_ variable.
