VITE_SUPABASE_URL=https://your-project.supabase.co
# Recommended for new Supabase projects.
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Legacy fallback for existing projects only.
VITE_SUPABASE_ANON_KEY=your-anon-key

# Local development only. Production/beta starts closed.
VITE_APP_ENV=local
VITE_REGISTRATION_ENABLED=true
VITE_LEGAL_OPERATOR_NAME=
VITE_LEGAL_CONTACT_EMAIL=

# Local admin/setup only. Never expose this in frontend code or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=PASTE_YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE
